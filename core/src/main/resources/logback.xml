<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%-5level] %logger{36} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Only show WARN+ by default. Use -Dlogging.level.com.minisast=DEBUG to debug. -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <logger name="com.minisast" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
</configuration>